#include <windows.h>

// Application Icon
1 ICON "magify.ico"

// Manifest embedded via linker

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Magify Team"
            VALUE "FileDescription",  "Magify — Radial File Editor & Controller"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "magify"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Magify Team"
            VALUE "OriginalFilename", "magify.exe"
            VALUE "ProductName",      "Magify"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
